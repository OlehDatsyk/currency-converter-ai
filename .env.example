# =============================================================================
# .env.example
# -----------------------------------------------------------------------------
# Copy this file to a new file named ".env" in the same folder, then fill in
# your real values. NEVER commit your real ".env" file to Git/GitHub.
#
#   Windows (VS Code terminal):   copy .env.example .env
#   macOS / Linux:                cp .env.example .env
# =============================================================================

# --- Flask settings -----------------------------------------------------
FLASK_SECRET_KEY=
FLASK_DEBUG=True

# --- AI provider: choose "openai" or "claude" ---------------------------
AI_PROVIDER=openai

# OpenAI (used if AI_PROVIDER=openai) - get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic / Claude (used if AI_PROVIDER=claude) - get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Currency exchange rate API -----------------------------------------
# Get a free key at https://www.exchangerate-api.com/
# (Optional: if left blank, the app automatically falls back to the free,
#  no-key-required Frankfurter API - great for quick testing.)
EXCHANGE_RATE_API_KEY=
