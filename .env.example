# ---------------------------------------------------------------------------
# Environment variables for Currency Converter Web
#
# HOW TO USE:
#   1. Copy this file and rename the copy to ".env"
#        (Windows PowerShell) Copy-Item .env.example .env
#        (Mac/Linux terminal)  cp .env.example .env
#   2. Fill in the values below.
#   3. Never commit your real .env file to Git (it is already listed in
#      .gitignore for you).
# ---------------------------------------------------------------------------

# Get a free API key at https://www.exchangerate-api.com/ (sign up, then
# copy the key from your dashboard). This app also works WITHOUT a key,
# using a free public fallback provider, but a key gives you higher
# request limits and more reliability.
EXCHANGE_RATE_API_KEY=

# Flask settings
FLASK_DEBUG=True
FLASK_SECRET_KEY=change-this-to-a-random-string

# Port the Flask app will run on
PORT=5000
